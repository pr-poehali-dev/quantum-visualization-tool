{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Login wrong credentials",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "nonexistent@example.com", "password": "wrong"},
      "expectedStatus": 401
    },
    {
      "name": "Register without data",
      "method": "POST",
      "path": "/?action=register",
      "body": {"email": "", "password": ""},
      "expectedStatus": 400
    },
    {
      "name": "Me without token",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    }
  ]
}
